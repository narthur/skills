target: skills/review/review-loop/record-skipped.sh
verify: bash skills/review/review-loop/record-skipped.test.sh
expect: FAIL  no looper refuses the skip
why:    this script wrapped its run-record write in `if [ -f "$RUNLOG" ]`, so with the writer absent it stamped the sha skipped and exited 0 while the run record never heard of it — the unexplained gate-clear the script exists to replace, reached through a partial install. A missing looper has to refuse, not quietly drop the audit row.
--- old
if [ ! -x "$LOOPER" ]; then
	echo "record-skipped: $LOOPER is missing, so the skip cannot be recorded; nothing recorded. Install it (SKILL.md Step 0): GOBIN=~/.local/bin go install github.com/pinepeakdigital/looper/cmd/looper@v0.2.7" >&2
	exit 1
fi
if ! "$LOOPER" record skipped --reason "$reason" >/dev/null; then
--- new
if [ -x "$LOOPER" ] && ! "$LOOPER" record skipped --reason "$reason" >/dev/null; then
