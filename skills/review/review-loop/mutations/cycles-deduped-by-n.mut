target: skills/review/review-loop/runlog.py
verify: cd skills/review/review-loop && ./runlog.test.sh
expect: FAIL  a restart's repeated cycle number is kept, not collapsed
why:    deduping cycle rows by n deletes the first pass of every Step 13 restart from the agent-cap tally
--- old
    return list(run.get("cycles") or [])
--- new
    seen = {}
    for c in run.get("cycles") or []:
        seen[c.get("n")] = c
    return list(seen.values())
