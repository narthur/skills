#!/usr/bin/env bash
# Dynamic a11y pass: pa11y-ci against the URLs the repo already declares in
# .pa11yci.json — the same file narthur/pa11y-ratchet reads in CI. This runs it
# pre-push instead of post-push, so findings reach the review loop before the
# code leaves the machine.
#
# Preconditions registry.toml has no field for, so they live here. Each exits 0
# with empty JSON ("no findings") rather than failing: a skipped audit must not
# look like a broken tool, nor like a page that audited clean.
#   1. the config must declare `urls` (blog/.pa11yci.json is defaults-only,
#      because the Action feeds it URLs from sitemap-url)
#   2. EVERY url must be loopback. pa11y-ci re-reads .pa11yci.json itself and
#      visits the whole list, so checking only the first would let a repo under
#      review pair a live localhost url[0] with off-box url[1..n] and drive our
#      headless Chrome at cloud metadata or an internal service, landing the
#      response in .code-analysis/report.md — which review agents then read.
#      Loopback-only is also the honest scope: this audits the local dev server.
#      Deployed URLs are pa11y-ratchet's job in CI.
#   3. something must be listening — we don't start a server (that's `run`'s job)
set -uo pipefail

CFG=".pa11yci.json"
skip() { echo "[]"; echo "pa11y: skipped — $1" >&2; exit 0; }

[ -f "$CFG" ] || skip "no $CFG"

probe="$(python3 - "$CFG" <<'PY'
import ipaddress, json, sys
from urllib.parse import urlparse

try:
    cfg = json.load(open(sys.argv[1]))
except (OSError, ValueError) as e:
    print("ERR unreadable %s: %s" % (sys.argv[1], e)); raise SystemExit

urls = cfg.get("urls") or []
if not urls:
    print("ERR declares no urls"); raise SystemExit

def loopback(host):
    if not host:
        return False
    if host.lower() in ("localhost", "localhost.localdomain"):
        return True
    try:
        return ipaddress.ip_address(host.strip("[]")).is_loopback
    except ValueError:
        return False   # a name we can't resolve statically is not trusted

first = None
for entry in urls:
    raw = entry if isinstance(entry, str) else (entry or {}).get("url", "")
    p = urlparse(raw)
    if not loopback(p.hostname):
        print("ERR non-loopback url %r; this pass audits the local dev server only" % (raw[:120],))
        raise SystemExit
    if first is None:
        first = (p.hostname, p.port or (443 if p.scheme == "https" else 80))

print("OK %s %s" % first)
PY
)"

case "$probe" in
  "OK "*) read -r _ host port <<<"$probe" ;;
  "ERR "*) skip "${probe#ERR }" ;;
  *) skip "could not read $CFG" ;;
esac

nc -z -G 2 "$host" "$port" 2>/dev/null || skip "nothing listening on $host:$port (start the dev server)"

# ponytail: --json is pa11y-ci's per-url issue map; the eslint-shaped counter can't
# read it, so `count = "pa11yci"` parses this in code-analysis.py.
exec npx --yes pa11y-ci --json "$@"
