#!/usr/bin/env bash
# Symlink every skill in this repo into ~/.claude/skills, so a `git pull` here
# is the whole update mechanism. Existing real directories are never touched;
# the script refuses rather than clobbering something it did not create.
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Parse args before touching DEST: taking it from $1 unconditionally made the
# documented `link-skills --prune` set DEST to the literal flag, and `mkdir -p`
# then killed the script under `set -e` before it linked or pruned anything.
DEST="$HOME/.claude/skills"
PRUNE=no
for arg in "$@"; do
  case "$arg" in
    --prune)     PRUNE=ask ;;
    --prune=yes) PRUNE=yes ;;
    --prune=no)  PRUNE=no ;;
    -*)          echo "unknown option: $arg" >&2; exit 2 ;;
    *)           DEST="$arg" ;;
  esac
done
mkdir -p "$DEST"

linked=0 skipped=0
for dir in "$REPO"/skills/*/*/; do
  name="$(basename "$dir")"
  target="$DEST/$name"
  if [[ -L "$target" ]]; then
    # Only repoint a symlink that is already ours. A foreign one (a skill the user
    # linked to a scratch checkout) is someone else's setup — the same "only ours"
    # test the prune path uses, so create and delete agree on what this script owns.
    if [[ "$(readlink "$target")" != "$REPO"/* ]]; then
      echo "skip: $name is a symlink to somewhere else" >&2; skipped=$((skipped+1))
    else
      ln -sfn "${dir%/}" "$target"; linked=$((linked+1))
    fi
  elif [[ -e "$target" ]]; then
    echo "skip: $name already exists and is not a symlink" >&2; skipped=$((skipped+1))
  else
    ln -s "${dir%/}" "$target"; linked=$((linked+1))
  fi
done
echo "linked $linked skill(s) into $DEST${skipped:+, skipped $skipped}"

# Prune symlinks this script created that no longer resolve — a skill renamed or
# deleted upstream leaves one behind, and a dangling entry in ~/.claude/skills is
# invisible until something tries to load it. Deleting is confirmed, never implied:
# --prune to remove, --prune=yes to skip the prompt (CI), nothing to just report.
dangling=()
for target in "$DEST"/*; do
  [[ -L "$target" ]] || continue
  dest="$(readlink "$target")"
  # only ours: points into this repo, and no longer resolves
  [[ "$dest" == "$REPO"/* ]] || continue
  [[ -e "$target" ]] && continue
  dangling+=("$target")
done

(( ${#dangling[@]} )) || exit 0

echo
echo "${#dangling[@]} dangling symlink(s) into this repo:"
for d in "${dangling[@]}"; do echo "  $(basename "$d") -> $(readlink "$d")"; done

if [[ "$PRUNE" == "no" ]]; then
  exit 0
elif [[ "$PRUNE" == "yes" ]]; then
  reply=y
elif [[ -t 0 ]]; then
  read -r -p "Delete these ${#dangling[@]} symlink(s)? [y/N] " reply
else
  # Non-interactive and not told explicitly: report and leave them alone.
  echo "(re-run with --prune=yes to delete, or --prune interactively)"
  exit 0
fi

if [[ "$reply" == [yY]* ]]; then
  for d in "${dangling[@]}"; do rm "$d"; echo "removed $(basename "$d")"; done
else
  echo "left in place"
fi
